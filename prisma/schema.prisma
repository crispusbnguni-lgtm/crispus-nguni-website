model PortfolioSite {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  name                   String
  title                  String
  bio                    String?
  profileImage           String?
  location               String?
  timezone               String                 @default("Africa/Nairobi")
  timezoneReviewRequired Boolean                @default(false)
  phone                  String?
  website                String?
  linkedin               String?
  instagram              String?
  facebook               String?
  youtube                String?
  tiktok                 String?
  whatsapp               String?

  template               String                 @default("professional")
  theme                  String                 @default("dark")
  dashboardBackground    String?
  websiteBackground      String?
  published              Boolean                @default(false)
  visibility             PortfolioVisibility    @default(PUBLIC)

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  slug                   String                 @unique
  showAbout              Boolean                @default(true)
  showContact            Boolean                @default(true)
  showEducation          Boolean                @default(true)
  showExperience         Boolean                @default(true)
  showHero               Boolean                @default(true)
  showInsights           Boolean                @default(true)
  showProjects           Boolean                @default(true)
  showServices           Boolean                @default(true)
  showSkills             Boolean                @default(true)
  showTestimonials       Boolean                @default(true)

  education              Education[]
  experiences            Experience[]
  insights               Insight[]
  leads                  Lead[]
  media                  Media[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts                  Post[]
  projects               Project[]
  services               Service[]
  skills                 Skill[]
  testimonials           Testimonial[]
  consultationTypes      ConsultationType[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  consultations          Consultation[]
}

model Lead {
  id              String            @id @default(cuid())
  portfolioId     String
  ownerId         String?
  createdById     String?
  name            String
  email           String?
  emailNormalized String?
  phone            String?
  phoneNormalized String?
  company         String?
  location        String?
  message         String?
  source          LeadSource        @default(WEBSITE)
  origin          LeadOrigin        @default(LEGACY)
  sourceDetail    String?
  temperature     LeadTemperature   @default(COLD)
  temperatureOverride Boolean       @default(true)
  status          LeadStatus        @default(NEW)
  score           Int               @default(0)
  scoreBreakdown  Json?
  nextBestAction  String?
  scoreCalculatedAt DateTime?
  nextScoreRefreshAt DateTime?
  interestedIn    String?
  budget          String?
  timeline        String?
  decisionMaker   Boolean?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  lostAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User?             @relation("LeadOwner", fields: [ownerId], references: [id])
  creator         User?             @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  portfolio       PortfolioSite     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  activities      LeadActivity[]
  consultations   Consultation[]
  scoreHistory    LeadScoreHistory[]

  @@index([portfolioId])
  @@index([ownerId])
  @@index([createdById])
  @@index([portfolioId, nextScoreRefreshAt])
  @@unique([portfolioId, emailNormalized])
  @@unique([portfolioId, phoneNormalized])
  @@index([status])
  @@index([temperature])
  @@index([source])
  @@index([score])
  @@index([nextFollowUpAt])
}

model LeadScoreHistory {
