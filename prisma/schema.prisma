  mealEntries    NutritionMealEntry[]
  planItems      NutritionMealPlanItem[]
  groceryItems   NutritionGroceryListItem[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, group, archivedAt, name])
}

