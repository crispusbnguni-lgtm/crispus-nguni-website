  imageAsset     WorkspaceMediaAsset? @relation("NutritionFoodImage", fields: [workspaceId, imageAssetId], references: [workspaceId, id], onDelete: Restrict)
  calories       Decimal?           @db.Decimal(12, 3)
  proteinGrams   Decimal?           @db.Decimal(12, 3)
  carbohydrateGrams Decimal?        @db.Decimal(12, 3)
  fatGrams       Decimal?           @db.Decimal(12, 3)
  fibreGrams     Decimal?           @db.Decimal(12, 3)
  micronutrients Json?
  allergens      String[]           @default([])
  ingredients    String[]           @default([])
  preparation    String?            @db.VarChar(2000)
  dataQuality    NutritionDataQuality @default(UNKNOWN)
  sourceName     String?            @db.VarChar(160)
  sourceUrl      String?            @db.VarChar(1000)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
