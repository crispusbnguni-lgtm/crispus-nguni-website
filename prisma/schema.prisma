generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                   @id @default(cuid())
  name                          String?
  email                         String                   @unique
  passwordHash                  String
  role                          UserRole                 @default(USER)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  ownedLeads                    Lead[]                   @relation("LeadOwner")
  leadActivities                LeadActivity[]           @relation("ActivityUser")
  mediaUploads                  Media[]                  @relation("MediaUploader")
  portfolioSite                 PortfolioSite?
  createdPosts                  Post[]                   @relation("PostCreator")
  ownedConsultations            Consultation[]           @relation("ConsultationOwner")
  createdConsultationActivities ConsultationActivity[]   @relation("ConsultationActivityUser")
  notifications                 Notification[]
  sessions  UserSession[] @relation("UserSessions")
  auditLogs AuditLog[]    @relation("AuditLogActor")
}

model PortfolioSite {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  name                   String
  title                  String
  bio                    String?
  profileImage           String?
  location               String?
  phone                  String?
  website                String?
  linkedin               String?
  instagram              String?
  facebook               String?
  youtube                String?
  tiktok                 String?
  whatsapp               String?
 
  template               String                 @default("professional")
  theme                  String                 @default("dark")
  dashboardBackground    String?
  websiteBackground      String?
  published              Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  slug                   String                 @unique
  showAbout              Boolean                @default(true)
  showContact            Boolean                @default(true)
  showEducation          Boolean                @default(true)
  showExperience         Boolean                @default(true)
  showHero               Boolean                @default(true)
  showInsights           Boolean                @default(true)
  showProjects           Boolean                @default(true)
  showServices           Boolean                @default(true)
  showSkills             Boolean                @default(true)
  showTestimonials       Boolean                @default(true)
  education              Education[]
  experiences            Experience[]
  insights               Insight[]
  leads                  Lead[]
  media                  Media[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts                  Post[]
  projects               Project[]
  services               Service[]
  skills                 Skill[]
  testimonials           Testimonial[]
  consultationTypes      ConsultationType[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  consultations          Consultation[]
}

model Lead {
  id              String            @id @default(cuid())
  portfolioId     String
  ownerId         String?
  name            String
  email           String?
  phone           String?
  company         String?
  location        String?
  message         String?
  source          LeadSource        @default(WEBSITE)
  temperature     LeadTemperature   @default(COLD)
  status          LeadStatus        @default(NEW)
  score           Int               @default(0)
  interestedIn    String?
  budget          String?
  timeline        String?
  decisionMaker   Boolean?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  convertedAt     DateTime?
  lostAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User?             @relation("LeadOwner", fields: [ownerId], references: [id])
  portfolio       PortfolioSite     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  activities      LeadActivity[]
  consultations   Consultation[]

  @@index([portfolioId])
  @@index([ownerId])
  @@index([status])
  @@index([temperature])
  @@index([source])
  @@index([score])
  @@index([nextFollowUpAt])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  userId    String?
  type      LeadActivityType
  title     String
  content   String?
  metadata  Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?            @relation("ActivityUser", fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Service {
  id          String        @id @default(cuid())
  portfolioId String
  title       String
  description String?
  icon        String?
  price       String?
  link        String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Experience {
  id             String        @id @default(cuid())
  portfolioId    String
  jobTitle       String
  company        String
  employmentType String?
  location       String?
  startDate      DateTime
  endDate        DateTime?
  current        Boolean       @default(false)
  description    String?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  portfolio      PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String        @id @default(cuid())
  portfolioId String
  name        String
  category    String?
  level       String?
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Project {
  id           String        @id @default(cuid())
  portfolioId  String
  title        String
  description  String
  image        String?
  link         String?
  category     String?
  technologies String?
  featured     Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  portfolio    PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id          String        @id @default(cuid())
  portfolioId String
  name        String
  role        String?
  company     String?
  message     String
  image       String?
  rating      Int?
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Education {
  id          String        @id @default(cuid())
  portfolioId String
  institution String
  degree      String
  field       String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean       @default(false)
  description String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Insight {
  id          String        @id @default(cuid())
  portfolioId String
  title       String
  slug        String
  excerpt     String?
  content     String
  coverImage  String?
  category    String?
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, slug])
}

model Media {
  id           String          @id @default(cuid())
  portfolioId  String
  uploadedById String?
  name         String
  originalName String
  storagePath  String
  mimeType     String
  size         Int
  type         MediaType
  visibility   MediaVisibility @default(PRIVATE)
  altText      String?
  width        Int?
  height       Int?
  duration     Float?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  portfolio    PortfolioSite   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation("MediaUploader", fields: [uploadedById], references: [id])
  postMedia    PostMedia[]

  @@index([portfolioId])
  @@index([uploadedById])
  @@index([type])
  @@index([visibility])
}

model Post {
  id          String         @id @default(cuid())
  portfolioId String
  createdById String?
  caption     String?
  visibility  PostVisibility @default(DRAFT)
  featured    Boolean        @default(false)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User?          @relation("PostCreator", fields: [createdById], references: [id])
  portfolio   PortfolioSite  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  media       PostMedia[]

  @@index([portfolioId])
  @@index([createdById])
  @@index([visibility])
  @@index([featured])
  @@index([publishedAt])
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId])
  @@index([mediaId])
  @@index([sortOrder])
}

model ConsultationType {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title       String
  description String?

  durationMinutes Int @default(30)

  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(15)

  minimumNoticeMinutes Int @default(120)
  maximumAdvanceDays   Int @default(60)

  meetingMethod String?

  active   Boolean @default(true)
  featured Boolean @default(false)

  sortOrder Int @default(0)

  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([active])
  @@index([sortOrder])
}

model AvailabilityRule {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  dayOfWeek Int

  startTime String
  endTime   String

  timezone String @default("Africa/Nairobi")

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([dayOfWeek])
  @@index([enabled])
}

model AvailabilityException {
  id          String                    @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  date DateTime

  type AvailabilityExceptionType

  startTime String?
  endTime   String?

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([date])
  @@index([type])
}

model Consultation {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User? @relation("ConsultationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  consultationTypeId String
  consultationType   ConsultationType @relation(fields: [consultationTypeId], references: [id], onDelete: Restrict)

  title String

  status ConsultationStatus @default(PENDING)

  scheduledAt DateTime

  durationMinutes Int

  timezone String @default("Africa/Nairobi")

  meetingMethod String?

  meetingUrl String?

  meetingLocation String?

  notes String?

  outcome String?

  cancellationReason String?

  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  rescheduledFromId String?
  rescheduledFrom   Consultation?  @relation("ConsultationReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Consultation[] @relation("ConsultationReschedule")

  activities ConsultationActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([leadId])
  @@index([ownerId])
  @@index([consultationTypeId])
  @@index([status])
  @@index([scheduledAt])
}

model ConsultationActivity {
  id             String        @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation("ConsultationActivityUser", fields: [userId], references: [id], onDelete: SetNull)

  title   String
  content String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String

  link     String?
  metadata Json?

  readAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@index([type])
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum LeadTemperature {
  HOT
  WARM
  COLD
  DORMANT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TIKTOK
  GOOGLE
  REFERRAL
  MANUAL
  EMAIL
  ADVERTISEMENT
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STATUS_CHANGE
  TEMPERATURE_CHANGE
  ASSIGNMENT
  FOLLOW_UP
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum PostVisibility {
  DRAFT
  PUBLISHED
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AvailabilityExceptionType {
  UNAVAILABLE
  CUSTOM_HOURS
}

enum NotificationType {
  LEAD_CREATED
  CONSULTATION_REQUESTED
  CONSULTATION_CONFIRMED
  CONSULTATION_CANCELLED
  FOLLOW_UP_DUE
  SYSTEM
}
model BackgroundOption {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("COLOR")
  value       String
  description String?
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}
model WelcomePageSettings {
  id        String   @id @default(cuid())
  key       String   @unique @default("main")
  content   Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
model DisplayStudioSettings {
  id          String   @id @default("main")
  preferences Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel  String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}