
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                   @id @default(cuid())
  name                          String?
  email                         String?                  @unique
  passwordHash                  String?
  emailVerifiedAt               DateTime?
  role                          UserRole                 @default(USER)
  accountStatus                 AdminAccountStatus       @default(ACTIVE)
  accountStatusReason           String?
  accountSuspendedUntil          DateTime?
  verificationStatus            AdminVerificationStatus  @default(PENDING)
  verificationReason            String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  ownedLeads                    Lead[]                   @relation("LeadOwner")
  createdLeads                   Lead[]                   @relation("LeadCreator")
  leadActivities                LeadActivity[]           @relation("ActivityUser")
  mediaUploads                  Media[]                  @relation("MediaUploader")
  portfolioSite                 PortfolioSite?
  createdPosts                  Post[]                   @relation("PostCreator")
  ownedConsultations            Consultation[]           @relation("ConsultationOwner")
  createdConsultationActivities ConsultationActivity[]   @relation("ConsultationActivityUser")
  notifications                 Notification[]
  sessions                      UserSession[]             @relation("UserSessions")
  auditLogs                     AuditLog[]                @relation("AuditLogActor")
  identities                    UserIdentity[]
  emailActionTokens              EmailActionToken[]
  passkeys                      PasskeyCredential[]
  securitySettings              UserSecuritySettings?
  totpCredential                TotpCredential?
  recoveryCodes                 RecoveryCode[]
  personalWorkspace             PersonalWorkspace?
  nutritionProfileAccesses      NutritionProfileAccess[]

  @@index([accountStatus, verificationStatus])
}

model PersonalWorkspace {
  id                    String       @id @default(cuid())
  userId                String       @unique
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                  WorkspaceMode @default(CUSTOM)
  focusAreas            String[]     @default([])
  timezone              String       @default("Africa/Nairobi")
  workingHoursStart     String       @default("09:00")
  workingHoursEnd       String       @default("17:00")
  breakMinutes          Int          @default(15)
  weekStartsOn          Int          @default(1)
  intelligencePermissions Json       @default("{}")
  intelligenceDismissedIds String[]  @default([])
  intelligenceFeedback Json          @default("{}")
  revision              Int          @default(0)
  onboardingCompletedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  pages                 WorkspacePage[]
  mediaAssets           WorkspaceMediaAsset[]
  tasks                 WorkspaceTask[]

  taskTags WorkspaceTaskTag[]
  projects WorkspaceProject[]
  databases              WorkspaceDatabase[]
  academicProfile        AcademicProfile?
  academicYears          AcademicYear[]
  academicCourses        AcademicCourse[]
  academicActivities     AcademicActivity[]
  classTimetableRules    AcademicClassTimetableRule[]
  intelligenceMemories  WorkspaceIntelligenceMemory[]
  financeTransactions   WorkspaceFinanceTransaction[]
  financePositions      WorkspaceFinancePosition[]
  financeBudgets        WorkspaceFinanceBudget[]
  financeGoals          WorkspaceFinanceGoal[]
  financeDebts          WorkspaceFinanceDebt[]
  financeRecurringSchedules WorkspaceFinanceRecurringSchedule[]
  financeReminders      WorkspaceFinanceReminder[]
  financeEvents         WorkspaceFinanceEvent[]
  nutritionProfiles     NutritionProfile[]
  nutritionFoods        NutritionFood[]
  nutritionRecipes      NutritionRecipe[]
  nutritionMeals        NutritionMeal[]
  nutritionHydrationEntries NutritionHydrationEntry[]
  nutritionMeasurements NutritionBodyMeasurement[]
  nutritionMealPlans   NutritionMealPlan[]
  nutritionGroceryLists NutritionGroceryList[]
  nutritionReminders    NutritionReminder[]
  nutritionEvents       NutritionEvent[]
  nutritionProfileAccesses NutritionProfileAccess[]
  securityVault          SecurityVault?
}

enum WorkspaceIntelligenceMemoryKind {
  PREFERENCE
  GOAL
  CONTEXT
}

enum WorkspaceFinanceRecordKind {
  INCOME
  EXPENSE
  TRANSFER
  SAVINGS_CONTRIBUTION
  SAVINGS_WITHDRAWAL
  DEBT_REPAYMENT
  ASSET_ACQUISITION
  ASSET_DISPOSAL
}

enum WorkspaceFinanceQuality {
  ACTUAL
  ESTIMATE
  PLANNED
}

enum WorkspaceFinancePositionKind {
  ASSET
  LIABILITY
}

enum WorkspaceFinanceGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum WorkspaceFinanceGoalMovementKind {
  CONTRIBUTION
  WITHDRAWAL
}

enum WorkspaceFinanceInterestType {
  FIXED
  VARIABLE
  UNKNOWN
}

enum WorkspaceFinanceRepaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  IRREGULAR
}

enum WorkspaceFinanceRecurringFrequency {
  WEEKLY
  MONTHLY
  ANNUAL
}

enum WorkspaceFinanceReminderKind {
  BILL_PAYMENT
  DEBT_REPAYMENT
  SAVINGS_CONTRIBUTION
  FINANCIAL_REVIEW
  BUDGET_CHECK_IN
}

enum WorkspaceFinanceReminderStatus {
  ACTIVE
  COMPLETED
  DISMISSED
}

enum NutritionProfileKind {
  ADULT
  CHILD
  ADOLESCENT
  PREGNANT
  BREASTFEEDING
  OLDER_ADULT
  ATHLETE
  HEALTH_CONDITION
}

enum NutritionReferenceSex {
  FEMALE
  MALE
  NOT_RECORDED
}

enum NutritionActivityLevel {
  LOW
  MODERATE
  HIGH
  NOT_RECORDED
}

enum NutritionObjective {
  BALANCED_EATING
  WEIGHT_MAINTENANCE
  HEALTHY_WEIGHT_GAIN
  HEALTHY_WEIGHT_LOSS
  SPORTS_FUELING
  GENERAL_WELLBEING
  NOT_RECORDED
}

enum NutritionFoodGroup {
  FRUITS
  VEGETABLES
  CEREALS_WHOLE_GRAINS
  ROOTS_TUBERS
  LEGUMES_PULSES
  MEAT_POULTRY
  FISH_SEAFOOD
  EGGS
  MILK_DAIRY
  NUTS_SEEDS
  OILS_FATS
  WATER_BEVERAGES
  MIXED_MEAL
  OTHER
}

enum NutritionDataQuality {
  VERIFIED_SOURCE
  ESTIMATED
  USER_ENTERED
  UNKNOWN
}

enum NutritionMealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum NutritionPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NutritionGroceryStatus {
  NEEDED
  PURCHASED
  SKIPPED
}

enum NutritionReminderKind {
  MEAL_PREPARATION
  GROCERY_SHOPPING
  MEAL_PLANNING
  HYDRATION
  NUTRITION_REVIEW
  ANTENATAL_APPOINTMENT
  OTHER
}

enum NutritionAccessRole {
  VIEWER
  CAREGIVER
  EDITOR
}

model WorkspaceIntelligenceMemory {
  id          String                          @id @default(cuid())
  workspaceId String
  workspace   PersonalWorkspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        WorkspaceIntelligenceMemoryKind
  label       String                          @db.VarChar(80)
  content     String                          @db.VarChar(500)
  enabled     Boolean                         @default(false)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, enabled, updatedAt])
}

enum WorkspaceTaskStatus {
  INBOX
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum WorkspaceTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkspaceProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkspaceDatabasePropertyType {
  TEXT
  NUMBER
  CHECKBOX
  DATE
  SELECT
  MULTI_SELECT
  URL
  STATUS
  RELATION
}

enum WorkspaceDatabaseViewType {
  TABLE
  BOARD
}

enum WorkspaceBlockType {
  PARAGRAPH
  HEADING
  BULLETED_LIST
  NUMBERED_LIST
  CHECKLIST
  TODO
  QUOTE
  CALLOUT
  DIVIDER
  CODE
  TABLE
  IMAGE
  LINK
  TOGGLE
  PAGE_REFERENCE
  DATE
  REMINDER
}

enum WorkspaceReminderStatus {
  SCHEDULED
  DELIVERED
  DISMISSED
  CANCELLED
}

enum AcademicActivityKind {
  ASSIGNMENT
  EXAM
  STUDY_SESSION
}

enum AcademicActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AcademicSubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AcademicExamKind {
  EXAM
  QUIZ
  PRACTICAL
  ORAL
  OTHER
}

enum AcademicClassExceptionKind {
  CANCELLED
  RESCHEDULED
}

model AcademicProfile {
  id            String            @id @default(cuid())
  workspaceId   String            @unique
  workspace     PersonalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "AcademicProfile_workspace_fkey")
  institution   String?
  program       String?
  department    String?
  revision      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AcademicYear {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   PersonalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "AcademicYear_workspace_fkey")
  name        String
  startsOn    DateTime          @db.Date
  endsOn      DateTime          @db.Date
  isCurrent   Boolean           @default(false)
  archivedAt  DateTime?
  revision    Int               @default(0)
  terms       AcademicTerm[]
  courses     AcademicCourse[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, startsOn, endsOn], map: "AcademicYear_workspace_dates_idx")
  @@unique([workspaceId], where: raw("\"isCurrent\" = true AND \"archivedAt\" IS NULL"), map: "AcademicYear_one_current_per_workspace_key")
}

model AcademicTerm {
  id          String       @id @default(cuid())
  workspaceId String
  academicYearId String
  academicYear AcademicYear @relation(fields: [workspaceId, academicYearId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicTerm_year_fkey")
  name        String
  startsOn    DateTime     @db.Date
  endsOn      DateTime     @db.Date
  isCurrent   Boolean      @default(false)
  archivedAt  DateTime?
  sortOrder   Int          @default(0)
  revision    Int          @default(0)
  courseLinks AcademicCourseTerm[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, academicYearId, id], map: "AcademicTerm_workspace_year_id_key")
  @@unique([workspaceId, academicYearId, name], map: "AcademicTerm_workspace_year_name_key")
  @@index([workspaceId, academicYearId, startsOn, endsOn], map: "AcademicTerm_workspace_year_dates_idx")
  @@unique([workspaceId], where: raw("\"isCurrent\" = true AND \"archivedAt\" IS NULL"), map: "AcademicTerm_one_current_per_workspace_key")
}

model AcademicCourse {
  id            String            @id @default(cuid())
  workspaceId   String
  academicYearId String
  workspace     PersonalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "AcademicCourse_workspace_fkey")
  academicYear  AcademicYear      @relation(fields: [workspaceId, academicYearId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicCourse_year_fkey")
  code          String?
  name          String
  description   String?
  credits       Decimal?          @db.Decimal(6, 2)
  color         String?
  archivedAt    DateTime?
  revision      Int               @default(0)
  terms         AcademicCourseTerm[]
  activities    AcademicActivity[]
  timetableRules AcademicClassTimetableRule[]
  knowledgeResources AcademicKnowledgeResource[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, academicYearId, id], map: "AcademicCourse_workspace_year_id_key")
  @@unique([workspaceId, academicYearId, code], map: "AcademicCourse_workspace_year_code_key")
  @@index([workspaceId, academicYearId, archivedAt, name], map: "AcademicCourse_workspace_year_archive_name_idx")
}

model AcademicCourseTerm {
  workspaceId    String
  academicYearId String
  courseId       String
  termId         String
  course         AcademicCourse @relation(fields: [workspaceId, academicYearId, courseId], references: [workspaceId, academicYearId, id], onDelete: Cascade, map: "AcademicCourseTerm_course_fkey")
  term           AcademicTerm   @relation(fields: [workspaceId, academicYearId, termId], references: [workspaceId, academicYearId, id], onDelete: Cascade, map: "AcademicCourseTerm_term_fkey")

  @@id([workspaceId, courseId, termId])
  @@index([workspaceId, academicYearId, termId], map: "AcademicCourseTerm_workspace_year_term_idx")
}

model AcademicActivity {
  id          String                 @id @default(cuid())
  workspaceId String
  courseId    String
  workspace   PersonalWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "AcademicActivity_workspace_fkey")
  course      AcademicCourse         @relation(fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicActivity_course_fkey")
  kind        AcademicActivityKind
  title       String
  description String?
  status      AcademicActivityStatus @default(PLANNED)
  startsAt    DateTime?
  endsAt      DateTime?
  dueOn       DateTime?              @db.Date
  dueAt       DateTime?
  timezone    String?
  location    String?
  archivedAt  DateTime?
  revision    Int                    @default(0)
  assignment  AcademicAssignment?
  exam        AcademicExam?
  studySession AcademicStudySession?
  taskLinks   AcademicActivityTaskLink[]
  projectLinks AcademicActivityProjectLink[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, courseId, kind, archivedAt, dueOn], map: "AcademicActivity_workspace_course_kind_archive_due_idx")
  @@index([workspaceId, startsAt, endsAt], map: "AcademicActivity_workspace_start_end_idx")
  @@index([workspaceId, dueAt, status], map: "AcademicActivity_workspace_due_status_idx")
}

model AcademicAssignment {
  workspaceId String
  activityId  String
  activity    AcademicActivity       @relation(fields: [workspaceId, activityId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicAssignment_activity_fkey")
  submissionStatus AcademicSubmissionStatus @default(NOT_STARTED)
  submittedAt DateTime?
  grade       String?
  feedback    String?

  @@id([workspaceId, activityId])
}

model AcademicExam {
  workspaceId String
  activityId  String
  activity    AcademicActivity @relation(fields: [workspaceId, activityId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicExam_activity_fkey")
  examKind    AcademicExamKind @default(EXAM)
  venue       String?
  topic       String?
  score       Decimal?         @db.Decimal(8, 2)
  maxScore    Decimal?         @db.Decimal(8, 2)

  @@id([workspaceId, activityId])
}

model AcademicStudySession {
  workspaceId String
  activityId  String
  activity    AcademicActivity @relation(fields: [workspaceId, activityId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicStudySession_activity_fkey")
  goal        String?
  topic       String?
  progress    Int              @default(0)
  completedAt DateTime?

  @@id([workspaceId, activityId])
}

model AcademicActivityTaskLink {
  workspaceId String
  activityId  String
  taskId      String
  activity    AcademicActivity @relation(fields: [workspaceId, activityId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicActivityTaskLink_activity_fkey")
  task        WorkspaceTask    @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicActivityTaskLink_task_fkey")
  createdAt   DateTime         @default(now())

  @@id([workspaceId, activityId, taskId])
  @@index([workspaceId, taskId], map: "AcademicActivityTaskLink_workspace_task_idx")
}

model AcademicActivityProjectLink {
  workspaceId String
  activityId  String
  projectId   String
  activity    AcademicActivity @relation(fields: [workspaceId, activityId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicActivityProjectLink_activity_fkey")
  project     WorkspaceProject @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicActivityProjectLink_project_fkey")
  createdAt   DateTime         @default(now())

  @@id([workspaceId, activityId, projectId])
  @@index([workspaceId, projectId], map: "AcademicActivityProjectLink_workspace_project_idx")
}

model AcademicClassTimetableRule {
  id          String            @id @default(cuid())
  workspaceId String
  courseId    String
  workspace   PersonalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "AcademicClassTimetableRule_workspace_fkey")
  course      AcademicCourse    @relation(fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicClassTimetableRule_course_fkey")
  title       String
  weekdays    Int[]
  startsOn    DateTime          @db.Date
  endsOn      DateTime          @db.Date
  localStart  String
  localEnd    String
  timezone    String
  location    String?
  archivedAt  DateTime?
  revision    Int               @default(0)
  exceptions  AcademicClassTimetableException[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, startsOn, endsOn, archivedAt], map: "AcademicClassTimetableRule_workspace_dates_idx")
  @@index([workspaceId, courseId], map: "AcademicClassTimetableRule_workspace_course_idx")
}

model AcademicClassTimetableException {
  id          String                   @id @default(cuid())
  workspaceId String
  ruleId      String
  rule        AcademicClassTimetableRule @relation(fields: [workspaceId, ruleId], references: [workspaceId, id], onDelete: Cascade, map: "AcademicClassTimetableException_rule_fkey")
  occurrenceOn DateTime                @db.Date
  kind        AcademicClassExceptionKind
  startsAt    DateTime?
  endsAt      DateTime?
  timezone    String?
  location    String?
  revision    Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([workspaceId, ruleId, occurrenceOn], map: "AcademicClassTimetableException_rule_date_key")
  @@index([workspaceId, occurrenceOn], map: "AcademicClassTimetableException_workspace_date_idx")
}

model WorkspacePage {
  id            String             @id @default(cuid())
  workspaceId   String
  workspace     PersonalWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        WorkspacePage?     @relation("WorkspacePageTree", fields: [workspaceId, parentId], references: [workspaceId, id], onDelete: Cascade)
  children      WorkspacePage[]    @relation("WorkspacePageTree")
  title         String             @default("Untitled")
  iconKey       String?
  sortOrder     Int                @default(0)
  isFavorite    Boolean            @default(false)
  isPinned      Boolean            @default(false)
  archivedAt   DateTime?
  deletedAt     DateTime?
  revision      Int                @default(0)
  searchText    String             @default("")
  coverAssetId  String?
  coverAsset    WorkspaceMediaAsset? @relation("WorkspacePageCover", fields: [workspaceId, coverAssetId], references: [workspaceId, id], onDelete: Restrict)
  blocks        WorkspaceBlock[]   @relation("WorkspacePageBlocks")
  sourceRefs    WorkspacePageReference[] @relation("WorkspaceReferenceSource")
  targetRefs    WorkspacePageReference[] @relation("WorkspaceReferenceTarget")
  tasks         WorkspaceTask[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, parentId, sortOrder])
  @@index([workspaceId, archivedAt, deletedAt, updatedAt])
  @@index([workspaceId, isFavorite, updatedAt])
  @@index([workspaceId, isPinned, updatedAt])
  @@unique([workspaceId, sortOrder], where: raw("\"parentId\" IS NULL"), map: "WorkspacePage_root_order_key")
  @@unique([workspaceId, parentId, sortOrder], where: raw("\"parentId\" IS NOT NULL"), map: "WorkspacePage_child_order_key")
}

model WorkspaceProject {
  id                    String                        @id @default(cuid())
  workspaceId           String
  name                  String
  description           String?
  status                WorkspaceProjectStatus        @default(PLANNED)
  priority              WorkspaceTaskPriority         @default(NORMAL)
  startsAt              DateTime?
  targetAt              DateTime?
  archivedAt            DateTime?
  revision              Int                           @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  academicActivityLinks AcademicActivityProjectLink[]
  workspace             PersonalWorkspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestones            WorkspaceProjectMilestone[]
  tasks                 WorkspaceTask[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, archivedAt, updatedAt], map: "WorkspaceProject_workspace_status_archive_updated_idx")
  @@index([workspaceId, targetAt], map: "WorkspaceProject_workspace_target_idx")
}

model WorkspaceProjectMilestone {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String?
  targetAt    DateTime?
  completedAt DateTime?
  sortOrder   Int              @default(0)
  revision    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     WorkspaceProject @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade, map: "WorkspaceProjectMilestone_project_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId, completedAt, targetAt], map: "WorkspaceProjectMilestone_project_completion_target_idx")
  @@index([workspaceId, projectId, sortOrder, id], map: "WorkspaceProjectMilestone_project_order_idx")
}

model WorkspaceTask {
  id                    String                     @id @default(cuid())
  workspaceId           String
  parentTaskId          String?
  projectId             String?
  pageId                String?
  title                 String
  description           String?
  status                WorkspaceTaskStatus        @default(INBOX)
  priority              WorkspaceTaskPriority      @default(NORMAL)
  startsAt              DateTime?
  dueAt                 DateTime?
  completedAt           DateTime?
  archivedAt            DateTime?
  notes                 String?
  recurrenceRule        String?
  sortOrder             Int                        @default(0)
  revision              Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  academicActivityLinks AcademicActivityTaskLink[]
  financeReminders      WorkspaceFinanceReminder[]
  page                  WorkspacePage?             @relation(fields: [workspaceId, pageId], references: [workspaceId, id], map: "WorkspaceTask_page_fkey")
  parentTask            WorkspaceTask?             @relation("WorkspaceTaskTree", fields: [workspaceId, parentTaskId], references: [workspaceId, id], onDelete: Cascade, map: "WorkspaceTask_parent_fkey")
  subtasks              WorkspaceTask[]            @relation("WorkspaceTaskTree")
  project               WorkspaceProject?          @relation(fields: [workspaceId, projectId], references: [workspaceId, id], map: "WorkspaceTask_project_fkey")
  workspace             PersonalWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "WorkspaceTask_workspace_fkey")
  labels                WorkspaceTaskLabel[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, sortOrder], map: "WorkspaceTask_root_order_key", where: raw("(\"parentTaskId\" IS NULL)"))
  @@unique([workspaceId, parentTaskId, sortOrder], map: "WorkspaceTask_child_order_key", where: raw("(\"parentTaskId\" IS NOT NULL)"))
  @@index([workspaceId, dueAt, status], map: "WorkspaceTask_due_status_idx")
  @@index([workspaceId, pageId], map: "WorkspaceTask_page_idx")
  @@index([workspaceId, parentTaskId, sortOrder], map: "WorkspaceTask_parent_order_idx")
  @@index([workspaceId, projectId, status, sortOrder], map: "WorkspaceTask_project_status_order_idx")
  @@index([workspaceId, status, archivedAt, dueAt], map: "WorkspaceTask_workspace_status_archive_due_idx")
}

model WorkspaceTaskTag {
  id          String               @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime             @default(now())
  tasks       WorkspaceTaskLabel[]
  workspace   PersonalWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "WorkspaceTaskTag_workspace_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, name], map: "WorkspaceTaskTag_workspace_name_key")
}

model WorkspaceTaskLabel {
  workspaceId String
  taskId      String
  tagId       String
  tag         WorkspaceTaskTag @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade, map: "WorkspaceTaskLabel_tag_fkey")
  task        WorkspaceTask    @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade, map: "WorkspaceTaskLabel_task_fkey")

  @@id([workspaceId, taskId, tagId])
  @@index([workspaceId, tagId], map: "WorkspaceTaskLabel_tag_idx")
}

model WorkspaceDatabase {
  id          String                      @id @default(cuid())
  workspaceId String
  name        String
  description String?
