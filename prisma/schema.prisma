  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId])
  @@index([mediaId])
  @@index([sortOrder])
}

model ConsultationType {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title       String
  description String?

  durationMinutes Int @default(30)

  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(15)

  minimumNoticeMinutes Int @default(120)
  maximumAdvanceDays   Int @default(60)

  meetingMethod String?

  active   Boolean @default(true)
  featured Boolean @default(false)

  sortOrder Int @default(0)

  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([active])
  @@index([sortOrder])
}

model AvailabilityRule {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  dayOfWeek Int

  startTime String
  endTime   String

  timezone String @default("Africa/Nairobi")

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([dayOfWeek])
  @@index([enabled])
}


model AvailabilityException {
  id          String                    @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  date DateTime

  type AvailabilityExceptionType

  startTime String?
  endTime   String?

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, date])
  @@index([portfolioId])
  @@index([date])
  @@index([type])
}


model Consultation {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioSite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User? @relation("ConsultationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  consultationTypeId String
  consultationType   ConsultationType @relation(fields: [consultationTypeId], references: [id], onDelete: Restrict)

  title String

  status ConsultationStatus @default(PENDING)

  scheduledAt DateTime

  durationMinutes Int

  timezone String @default("Africa/Nairobi")

  meetingMethod String?

  meetingUrl String?

  meetingLocation String?

  notes String?

  outcome String?

  cancellationReason String?

  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  rescheduledFromId String?
  rescheduledFrom   Consultation?  @relation("ConsultationReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Consultation[] @relation("ConsultationReschedule")

  activities ConsultationActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([leadId])
  @@index([ownerId])
  @@index([consultationTypeId])
  @@index([status])
  @@index([scheduledAt])
}

model ConsultationActivity {
  id             String        @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation("ConsultationActivityUser", fields: [userId], references: [id], onDelete: SetNull)

  title   String
  content String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String

  link     String?
  metadata Json?

  readAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@index([type])
}

